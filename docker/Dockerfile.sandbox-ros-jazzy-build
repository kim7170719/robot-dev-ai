# Build only when an operator explicitly provisions the E2 sandbox image.
# This definition is never pulled or built by application code.
FROM ros:jazzy-ros-base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init || true

WORKDIR /work
